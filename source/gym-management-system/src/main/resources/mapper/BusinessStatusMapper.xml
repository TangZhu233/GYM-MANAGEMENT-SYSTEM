<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gym.mapper.BusinessStatusMapper">

    <select id="selectStatus" resultType="businessStatus">
        SELECT id, status, update_time
        FROM business_status
        WHERE id = 1
    </select>

    <update id="updateStatus">
        UPDATE business_status
        SET status = #{status}
        WHERE id = 1
    </update>

</mapper>
